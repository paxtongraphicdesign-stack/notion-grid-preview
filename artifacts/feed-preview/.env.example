# ── Required ──────────────────────────────────────────────────────────────────

# Your Notion integration secret.
# Create one at https://www.notion.so/my-integrations
# Must start with "secret_"
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The ID of your Notion content calendar database.
# Find it in the database URL:
#   notion.so/yourworkspace/THIS-IS-THE-ID?v=...
# Copy the 32-character hex string (hyphens optional).
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
